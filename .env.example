# =========================================================================
# OestudoLiberta — variáveis de ambiente (EXEMPLO)
# Copie para ".env" e preencha os valores. NUNCA comite o arquivo .env real.
# =========================================================================

# ── Aplicação ─────────────────────────────────────────────
APP_NAME="OestudoLiberta"
ENVIRONMENT=development          # development | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Banco de dados (PostgreSQL) ───────────────────────────
# Desenvolvimento: PostgreSQL local (D:\postgre) na porta 5432
# Alternativa Docker: use 5433 (ver docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oestudo_liberta
POSTGRES_USER=oestudo_app
POSTGRES_PASSWORD=change-me

# URL única consumida pelo SQLAlchemy/Alembic (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://oestudo_app:change-me@localhost:5432/oestudo_liberta

# ── Firebase Authentication ───────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# ── CORS (frontend Next.js) ───────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Cloudflare Stream (vídeos) — SPRINT 2 ─────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Código do subdomínio customer-<CODIGO>.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# ── Mercado Pago (pagamentos) — SPRINT 4 ──────────────────
MERCADO_PAGO_ACCESS_TOKEN=
# Chave secreta do webhook (Painel do Mercado Pago > Suas integrações > Webhooks)
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública que o Mercado Pago chama (em dev, use um túnel: ex. ngrok)
MERCADO_PAGO_NOTIFICATION_URL=

# ── Frontend ──────────────────────────────────────────────
# Base usada nos back_urls do checkout (retorno do aluno após pagar)
FRONTEND_BASE_URL=http://localhost:3000

# ── Bootstrap de administrador ────────────────────────────
# E-mail que será promovido a ADMIN pelo script de seed (procedimento seguro)
ADMIN_BOOTSTRAP_EMAIL=
